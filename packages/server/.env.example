SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<Supabase dashboard → Project Settings → API → service_role (SECRET, never commit)>
PORT=3001
# Comma-separated list of Origins the browser dashboard is served from.
# Defaults to http://localhost:3002 (the dev port for packages/web).
# ALLOWED_ORIGINS=http://localhost:3002,https://your-web-domain.example
