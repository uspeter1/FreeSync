# Build-time defaults baked into the compiled plugin bundle. Users can still
# override each of these in the plugin's Advanced settings after install.
#
# Copy this file to `.env` and edit — `.env` is gitignored.
# Inline env vars still win, e.g.:
#   RELAY_URL=wss://... npm run build --workspace=packages/plugin

# WebSocket URL of the FreeSync relay. Include the `/sync` path prefix.
RELAY_URL=ws://localhost:3001/sync

# Web-app URL used for the "Sign up" and "Open dashboard" links in the plugin.
WEB_APP_URL=https://freesync.app
